# Copy to .env (ignored by git) and fill in. Never commit the real key.
# OpenRouteService API key (free): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Minutes between automatic feed refreshes (0 = off, otherwise at least 5).
# Needed for the price history to fill up and for price alerts to be evaluated.
INGEST_INTERVAL_MINUTES=15
# Optional overrides
# PORT=3000
# HOST=0.0.0.0
# ROUTE_RATE_LIMIT_PER_MINUTE=20

# Station brands (E.Leclerc, TotalEnergies...) are downloaded weekly from OpenStreetMap.
# Set to false to keep the brands already stored. Manual run: npm run brands
BRANDS_REFRESH=true
